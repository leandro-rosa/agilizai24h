generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One immutable version of every number that shapes a recommendation —
/// tolerance, bands, thresholds, visit weekdays. Append-only: changing a
/// parameter creates a NEW row, the previous one stays readable, and every
/// stored result records the version that produced it (design D11). The latest
/// row is the current version.
model ParameterVersion {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  /// Free text: who or what created it ("initial defaults", "owner recalibration…").
  note       String?
  /// The full, validated parameter document — never a partial patch.
  values     Json

  runs EngineRun[]

  @@map("parameter_version")
}

/// Versioned pricing policy (margin, tax, rounding, guards) — append-only like
/// ParameterVersion, but its own table so a pricing change never bumps the
/// version the mix engine records on its results.
model PricingParameterVersion {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  note       String?
  /// The full, validated pricing document — never a partial patch.
  values     Json

  @@map("pricing_parameter_version")
}

/// The baseline quantity ("qtd itens por loja") of a SKU — ONE value per SKU,
/// applied to every store (owner decision 2026-09-30), with an append-only
/// history: a re-import adds a row, it never overwrites. The current baseline
/// is the latest row whose effective date has been reached.
model BaselineQuantity {
  id             Int      @id @default(autoincrement())
  sku            String
  quantity       Int
  /// Where the value came from, e.g. the pricing sheet file name.
  source         String
  effective_from DateTime
  created_at     DateTime @default(now())

  @@index([sku, effective_from, id])
  @@map("baseline_quantity")
}

/// Planned visit weekdays of one store (ISO: 1 = Monday … 7 = Sunday), an
/// override of the default in the parameters. Append-only; the latest row of a
/// store wins. Never inferred silently from history.
model StoreSchedule {
  id             Int      @id @default(autoincrement())
  store_id       Int
  weekdays       Int[]
  note           String?
  effective_from DateTime @default(now())
  created_at     DateTime @default(now())

  @@index([store_id, id])
  @@map("store_schedule")
}

/// "Closed pack preferred in this store" for a Product x Store. Stored and
/// shown, NEVER read by any calculation — it only becomes an operational
/// option beside a result. Append-only; the latest row of a pair wins.
model ProductStoreFlag {
  id                Int      @id @default(autoincrement())
  store_id          Int
  sku               String
  prefer_closed_pack Boolean
  created_at        DateTime @default(now())

  @@index([store_id, sku, id])
  @@map("product_store_flag")
}

/// One execution of the engine. Immutable once finished; a later run never
/// overwrites it (design D2/D14).
model EngineRun {
  id                   String   @id
  /// 'queued' | 'running' | 'completed' | 'failed'
  status               String
  engine_version       String
  parameter_version_id Int
  /// The reference date balance ages are measured from.
  as_of                DateTime
  /// The months of history the run covers, YYYY-MM.
  range_from           String
  range_to             String
  /// The last month the data really covers, computed from what the stores had
  /// (supply AND sales present for the configured share of them). Null until the
  /// run finishes — a run never claims a month it did not read.
  data_through         String?
  stores_total         Int      @default(0)
  stores_done          Int      @default(0)
  error                String?
  created_at           DateTime @default(now())
  finished_at          DateTime?

  parameters      ParameterVersion @relation(fields: [parameter_version_id], references: [id])
  recommendations Recommendation[]
  stores          EngineRunStore[]

  @@index([created_at])
  @@map("engine_run")
}

/// What happened to one store in one run: processed, or skipped with the reason.
/// A skipped store is NEVER read as "zero recommendations" — it is listed.
model EngineRunStore {
  id         Int      @id @default(autoincrement())
  run_id     String
  store_id   Int
  /// 'done' | 'skipped'
  status     String
  /// Why it was skipped (a failed read, a synthetic store…); null when done.
  reason     String?
  pairs      Int      @default(0)
  /// Per month: whether supply and sales were present for this store.
  months     Json?
  created_at DateTime @default(now())

  run EngineRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@unique([run_id, store_id])
  @@map("engine_run_store")
}

/// The full result of the engine for one Product x Store in one run, plus the
/// columns needed to filter on it. The JSON is the complete, explainable result
/// (facts, evidence, limitations); the columns are only an index over it.
model Recommendation {
  id        Int    @id @default(autoincrement())
  run_id    String
  store_id  Int
  sku       String
  /// 'keep' | 'test' | 'evaluate_removal' | 'insufficient_data'
  mix       String
  /// 'keep' | 'reduce' | 'increase' | 'test' | 'no_evidence'
  quantity_action String
  /// 'within_tolerance' | 'outside_tolerance' | 'not_verifiable'
  tolerance_status String
  /// One of the five exclusive coverage categories.
  coverage_category String
  releases_balance_use Boolean
  result    Json
  created_at DateTime @default(now())

  run EngineRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@unique([run_id, store_id, sku])
  @@index([run_id, store_id])
  @@map("recommendation")
}

/// One replay of the engine over history (design D13). Stores its aggregates,
/// coverage and sensitivity reports; never a verdict.
model BacktestRun {
  id                   String   @id
  engine_version       String
  parameter_version_id Int
  /// The origins replayed, as ISO dates.
  origins              Json
  data_through         String
  /// Aggregates, coverage report and count-rule sensitivity tables.
  report               Json
  created_at           DateTime @default(now())

  results BacktestResult[]

  @@map("backtest_run")
}

/// One Product x Store at one origin: what was recommended and what followed.
model BacktestResult {
  id          Int      @id @default(autoincrement())
  run_id      String
  origin      DateTime
  store_id    Int
  sku         String
  /// 'keep' | 'reduce' | 'increase' | 'test' | 'evaluate_removal' | 'no_evidence' | null when no recommendation could be given
  action      String?
  /// 'coherent' | 'incoherent' | 'inconclusive' | null — an estimate, never proof.
  coherence   String?
  coverage_category String
  outcome     Json

  run BacktestRun @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id, origin])
  @@map("backtest_result")
}

/// One monthly refresh: an engine run over the history through a month plus the
/// backtest (coverage and count-rule sensitivity included) as ONE linked set
/// (design D14). A set is never overwritten or deleted; once `completed` its
/// fields never change. Only `refresh_pointer` moves.
model RefreshSet {
  id                   String    @id
  /// 'running' | 'completed' | 'failed'. Completed only when the engine run is
  /// completed AND the backtest is completed.
  status               String
  /// The month the refresh was started for (the latest available month then).
  target_month         String
  /// The last month the set really covers, taken from what the engine run read.
  /// Null until the set completes — a set never claims a month it did not read.
  data_through         String?
  range_from           String
  range_to             String
  as_of                DateTime
  engine_version       String
  parameter_version_id Int
  engine_run_id        String?
  /// The id the backtest port returned; the backtest tables are owned by the backtest module.
  backtest_id          String?
  /// 'event' | 'manual'
  trigger              String
  error                String?
  /// How many times the set was checked for completion (bounded by a timeout).
  polls                Int       @default(0)
  created_at           DateTime  @default(now())
  /// When the whole set finished — the "last updated" of every figure in it.
  computed_at          DateTime?

  @@index([target_month, status])
  @@index([data_through, created_at])
  @@map("refresh_set")
}

/// The single mutable row: which completed set is current. It moves only when a
/// whole set has finished (and never backwards in `data_through`).
model RefreshPointer {
  id             Int      @id @default(1)
  refresh_set_id String
  moved_at       DateTime @default(now())

  @@map("refresh_pointer")
}
