generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Derived stock for one store, SKU and period.
///
/// Materialised rather than computed per request: a point-in-time read would
/// otherwise re-sum every movement since the store opened, on every call. It is
/// a read model — the movements in sales-service and supply-service remain the
/// source of truth, and this is rebuilt from them.
model StockSnapshot {
  id       Int    @id @default(autoincrement())
  store_id Int
  sku      String
  /// The month, as YYYY-MM.
  period   String

  /// The period's own movements, kept so a figure can be explained without
  /// calling back to the owning services.
  restocked Int
  sold      Int
  removed   Int
  /// Net inventory adjustment — signed. Moves stock exactly like a restock or
  /// a removal; kept as its own term because finance-service values it
  /// separately (design D4/D6 of align-ingestion-with-real-reports).
  adjustment Int @default(0)

  /// Cumulative through this period. May be negative — that means the movement
  /// data is inconsistent, and clamping it would hide the very problem that
  /// needs fixing.
  closing_stock Int

  /// The operators' own reading for this period, when supply-service has one —
  /// stored for visibility, never compared against `closing_stock`. It is a
  /// reading taken at the moment of a specific restocking visit, not a
  /// month-end figure, and the sales report carries no per-sale date to tell
  /// what sold before or after that visit (design D5 of
  /// align-ingestion-with-real-reports, reversed after testing the
  /// comparison against real data).
  recorded_closing_balance Int?

  computed_at DateTime @default(now())

  @@unique([store_id, sku, period])
  @@index([store_id, period])
  @@map("stock_snapshot")
}

/// The level below which a SKU is considered low at a given store.
///
/// Configured per store and SKU, replacing the admin panel mock's hardcoded
/// "15 for beverages, 8 otherwise" — which was never a real setting.
model MinimumLevel {
  id       Int    @id @default(autoincrement())
  store_id Int
  sku      String
  minimum  Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([store_id, sku])
  @@map("minimum_level")
}

/// Records that a store's stock has been derived at all.
///
/// Without it, "never computed" and "computed, and this SKU has no movements"
/// both look like an empty result.
model DerivedStore {
  id       Int    @id @default(autoincrement())
  store_id Int    @unique

  last_computed_at DateTime @default(now())
  latest_period    String?

  @@map("derived_store")
}
