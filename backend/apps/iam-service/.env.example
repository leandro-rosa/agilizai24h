# iam-service — copy to .env for local runs outside Docker.
#
# NOTE: there is deliberately no WITH_KAFKA_BROKERS here. That variable exists
# to work around a DI hazard in @app/hold-it, and this service registers no
# queues, so it never imports HoldItModule. Any service that DOES register it
# must set WITH_KAFKA_BROKERS=false or NestJS fails at startup — see the root
# .env.example.

# This service's own database. Database-per-service: no other service reads
# these tables, and no other service's DATABASE_URL points here.
DATABASE_URL=postgresql://agiliz:agiliz-dev-secret@127.0.0.1:5433/iam

PORT=3000

# Session lifetime. Introspection deliberately does not extend it.
SESSION_TTL_SECONDS=28800

# Failed-attempt throttling, counted per account. The window always expires on
# its own — throttling must never need an administrator to undo.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_THROTTLE_SECONDS=900

# Argon2id parameters. Raising memory cost is the most effective hardening.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Only read by the one-off bootstrap command, never by the running service.
# Leave unset in normal operation.
# IAM_BOOTSTRAP_EMAIL=
# IAM_BOOTSTRAP_PASSWORD=
# IAM_BOOTSTRAP_NAME=

# Postgres container settings consumed by docker-compose.yml.
IAM_POSTGRES_USER=agiliz
IAM_POSTGRES_PASSWORD=agiliz-dev-secret
IAM_POSTGRES_DB=iam
IAM_POSTGRES_HOST_PORT=5433
