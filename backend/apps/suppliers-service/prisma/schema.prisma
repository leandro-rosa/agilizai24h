// Fornecedor e as grafias sob as quais ele aparece.
//
// Origem na planilha de relatórios: as abas `DE-PARA`, `Página64`, `Página1`
// (fornecedores de congelados) e a coluna `Fornecedor` de `produtos` /
// `lista de produtos mercado`.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Supplier {
  id         Int     @id @default(autoincrement())
  name       String
  legal_name String?
  /// CNPJ. Opcional: parte dos fornecedores do extrato são pessoa física ou
  /// só aparecem pelo nome de fantasia no lançamento do cartão.
  tax_id     String? @unique
  /// frozen | beverages | grocery | wholesale | equipment | services | system
  category   String
  contact_name String?
  phone        String?
  email        String?
  notes        String?
  /// active | inactive
  status     String  @default("active")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  aliases     SupplierAlias[]
  purchases   Purchase[]
  settlements Settlement[]

  @@index([status])
  @@index([category])
  product_codes SupplierProductCode[]

  @@map("supplier")
}

/// Um mesmo fornecedor aparece com grafia diferente em cada extrato
/// ("ASSAÍ ATACADISTA LJ49", "ASSAI ATACADISTA LJ144", "Assaí"). Sem esta
/// tabela a conciliação do extrato não tem como convergir para um cadastro,
/// e cada mês vira um fornecedor novo.
model SupplierAlias {
  id          Int    @id @default(autoincrement())
  supplier_id Int
  /// Como apareceu na origem, preservado para auditoria.
  alias       String
  /// `alias` dobrado: maiúsculas, sem acento, sem pontuação, espaço colapsado.
  /// É por aqui que a resolução casa, e o unique impede que duas grafias
  /// equivalentes apontem para fornecedores diferentes.
  normalized_alias String @unique
  created_at  DateTime @default(now())

  supplier Supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)

  @@index([supplier_id])
  @@map("supplier_alias")
}

/// Uma compra de um fornecedor: manual (quem não emite nota) ou vinda de NF-e.
/// A rede compra, não a loja: não há `store_id`.
model Purchase {
  id          Int      @id @default(autoincrement())
  supplier_id Int
  ordered_on  DateTime @db.Date
  /// manual | nfe
  origin      String
  /// Número da NF, quando há. Único por fornecedor: importar a mesma nota duas vezes não duplica.
  /// NULL não colide (Postgres), então várias compras sem nota convivem.
  invoice_number String?
  /// Chave de acesso da NF-e (44 dígitos), quando veio de XML.
  invoice_key    String?
  /// Onde o arquivo bruto ficou no storage, para auditoria.
  invoice_object_key String?
  notes       String?

  /// requisition | awaiting_invoice | invoiced | awaiting_receipt | received. Só `received` conta como compra.
  /// Compras anteriores às etapas migraram como `received`.
  status      String   @default("received")
  /// Quem registrou o pedido (e-mail da sessão, nunca o que o cliente manda).
  created_by  String?
  sent_at     DateTime?
  sent_by     String?
  invoiced_at DateTime?
  invoiced_by String?
  /// Fornecedor que não emite nota: o passo "faturado" é aceito sem número.
  without_invoice Boolean @default(false)
  /// Dia do recebimento. Mês da compra para a análise e o acerto (cai em ordered_on para as antigas).
  received_on DateTime? @db.Date
  received_at DateTime?
  received_by String?
  /// Prazo de entrega combinado.
  expected_delivery_on DateTime? @db.Date
  /// on_receipt (paga ao receber) | due_date (boleto para o dia payment_due_on) | NULL (não informado).
  payment_term   String?
  payment_due_on DateTime? @db.Date

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  supplier Supplier        @relation(fields: [supplier_id], references: [id])
  items    PurchaseItem[]
  events   PurchaseEvent[]
  emails   PurchaseEmail[]

  @@unique([supplier_id, invoice_number])
  @@index([supplier_id, ordered_on])
  @@index([ordered_on])
  @@index([status])
  @@map("purchase")
}

/// Um produto dentro de uma compra. O custo pago aqui é FATO da compra; o custo
/// cadastrado em products-service é referência e não é alterado por ela.
model PurchaseItem {
  id          Int    @id @default(autoincrement())
  purchase_id Int
  sku         String
  /// Como o item apareceu na nota/planilha, preservado para auditoria.
  description String?
  /// Unidades. Embalagem (caixa de 24) já convertida na entrada.
  quantity    Int
  /// Unidades recebidas. Padrão = pedido; a diferença fica visível. NULL só enquanto não recebido.
  received_quantity Int?
  /// Centavos por unidade. Bonificação grava o custo de referência (ou 0), nunca é cobrada.
  unit_cost_cents Int
  /// paid | bonus | on_sale
  condition   String
  /// pending | paid. Só vale para `paid`; `on_sale` é quitado pelo acerto e `bonus` não deve nada.
  payment_status String   @default("pending")
  paid_on        DateTime? @db.Date
  payment_note   String?
  created_at  DateTime @default(now())

  purchase Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  @@index([purchase_id])
  @@index([sku])
  @@map("purchase_item")
}

/// "No catálogo deste fornecedor, o código X é o produto Y". Criado quando o operador escolhe o produto de uma linha de nota que não
/// casou por código de barras; nas próximas notas do fornecedor a linha casa sozinha. Nunca é inferido.
model SupplierProductCode {
  id          Int      @id @default(autoincrement())
  supplier_id Int
  /// `cProd` da nota, como veio.
  code        String
  sku         String
  created_at  DateTime @default(now())

  supplier Supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)

  @@unique([supplier_id, code])
  @@map("supplier_product_code")
}

/// Acerto semanal de um fornecedor com itens `on_sale`. Nasce como proposta,
/// vira confirmado só por uma pessoa e depois pago (status registrado; o
/// sistema nunca paga nem lança nada).
model Settlement {
  id          Int      @id @default(autoincrement())
  supplier_id Int
  /// Segunda-feira da semana ISO.
  week_start  DateTime @db.Date
  /// proposal | confirmed | paid
  state       String   @default("proposal")
  owed_cents  Int
  /// A semana não tem todos os dados (recibos sem data, lojas sem importação).
  partial     Boolean  @default(false)
  /// Linhas por item (entregue, vendido, vencido, devolvido, em aberto, devido) e as notas de qualidade.
  evidence    Json
  confirmed_at DateTime?
  paid_on      DateTime? @db.Date
  payment_note String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplier_id], references: [id])

  @@unique([supplier_id, week_start])
  @@index([state])
  @@map("settlement")
}

/// Histórico de etapas de um pedido: de/para, quem e quando. Nunca editado.
model PurchaseEvent {
  id          Int      @id @default(autoincrement())
  purchase_id Int
  /// NULL quando o pedido nasceu direto numa etapa.
  from_status String?
  to_status   String
  actor       String?
  note        String?
  created_at  DateTime @default(now())

  purchase Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  @@index([purchase_id])
  @@map("purchase_event")
}

/// Registro de cada tentativa de envio do pedido ao fornecedor, com sucesso ou erro.
model PurchaseEmail {
  id          Int      @id @default(autoincrement())
  purchase_id Int
  to_address  String
  subject     String
  has_attachment Boolean @default(false)
  /// sent | failed
  result      String
  error       String?
  message_id  String?
  sent_by     String?
  created_at  DateTime @default(now())

  purchase Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  @@index([purchase_id])
  @@map("purchase_email")
}
