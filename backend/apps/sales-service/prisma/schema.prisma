generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// What was sold, at the grain the POS actually reports: per store, per period,
/// per SKU. Deliberately NOT per transaction — the source reports do not carry
/// transaction detail, and modelling a grain the data cannot support would mean
/// inventing it.
model SalesRecord {
  id       Int    @id @default(autoincrement())
  store_id Int
  /// The month, as YYYY-MM.
  period   String
  sku      String

  quantity_sold Int
  /// Integer minor units (centavos). Never a float: these are summed across
  /// thousands of rows, which is exactly the pattern that accumulates binary
  /// floating-point error.
  revenue_cents Int

  /// Which ingestion produced this row, so any stored figure can be traced back
  /// to the uploaded file it came from.
  ingestion_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  /// The grain, enforced by the database rather than only by application logic.
  @@unique([store_id, period, sku])
  @@index([store_id, period])
  @@map("sales_record")
}

/// One row per sales transaction — additive to `SalesRecord`, never a
/// replacement for it. Only the network-wide, per-transaction sales format
/// (Aug 2026) produces these; the old per-SKU export never does. `result`
/// carries the source report's `Resultado` verbatim, including non-'OK'
/// outcomes — a declined or cancelled transaction is recorded here (never
/// counted in `SalesRecord`'s aggregate), because it is the only way an
/// approval rate can ever be computed. Every field beyond the required ones
/// is optional because the source report's own columns are optional at the
/// file level — see add-sales-transaction-detail design D3.
model SalesTransaction {
  id       Int    @id @default(autoincrement())
  store_id Int
  /// The month, as YYYY-MM — same grain convention as SalesRecord, even
  /// though occurred_at gives the exact moment.
  period   String

  occurred_at DateTime?
  sku         String
  quantity    Int

  /// Integer minor units (centavos). Never a float.
  amount_paid_cents     Int
  original_amount_cents Int?
  discount_cents        Int?
  /// Amount settled after acquirer/payment fees — a treasury concept, never CMV/margin.
  net_amount_cents      Int?
  /// The receipt/basket identifier — groups several rows into one purchase.
  coupon                String?

  /// Verbatim from the report — not narrowed to an enum, see design D3.
  result String

  method            String?
  acquirer          String?
  card_brand        String?
  card_last_digits  String?
  internal_code     String?
  acquirer_code     String?
  pos_id            String?
  machine_model     String?
  /// An identifier the report assigns, not a quantity — kept as text.
  buyer_number      String?

  ingestion_id String
  created_at   DateTime @default(now())

  @@index([store_id, period])
  @@index([store_id, period, occurred_at])
  @@map("sales_transaction")
}

/// Records that a store's period was ingested at all.
///
/// This is what makes "never ingested" distinguishable from "ingested, and
/// genuinely had no sales" — without it, both look like an empty result set,
/// and a caller cannot tell a missing upload from a quiet month.
model IngestedPeriod {
  id       Int    @id @default(autoincrement())
  store_id Int
  period   String

  ingestion_id String
  row_count    Int
  ingested_at  DateTime @default(now())

  @@unique([store_id, period])
  @@map("ingested_period")
}
