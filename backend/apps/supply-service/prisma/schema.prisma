generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A removal reason and whether it counts as real loss.
///
/// Modelled as a TABLE with an explicit flag, not as an enum in code and not as
/// a hard-coded list in a WHERE clause. A rule written as
/// `WHERE reason IN ('expired','damaged','other')` is invisible to the
/// operators, duplicated at every call site, and silently wrong the moment a
/// seventh reason appears in a report. As data, the rule has one home and can
/// be shown in the UI next to the number it produced.
model RemovalReason {
  id   Int    @id @default(autoincrement())
  /// Stable machine key, e.g. "expired". Not the Portuguese label.
  key  String @unique
  /// What the operators call it, e.g. "Validade vencida".
  label String
  /// THE rule. Expired, damaged product and other reason are loss; return,
  /// transfer and internal use are not.
  counts_as_loss Boolean

  created_at DateTime @default(now())

  removals RemovalRecord[]

  @@map("removal_reason")
}

/// Units put onto the shelf, per store, period and SKU.
model RestockRecord {
  id       Int    @id @default(autoincrement())
  store_id Int
  period   String
  sku      String

  quantity_restocked Int
  ingestion_id       String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([store_id, period, sku])
  @@index([store_id, period])
  @@map("restock_record")
}

/// Units taken off the shelf, ALREADY SPLIT PER REASON.
///
/// A reported line of "-6 Devolução, -3 Outro motivo" is stored as two rows.
/// The combined 9 exists nowhere as a quantity: if it were stored alongside the
/// split, the two could disagree and every consumer would have to know which to
/// trust. Storing only the split makes "9 units removed yields 3 units of loss"
/// structurally true rather than dependent on a correct query.
model RemovalRecord {
  id        Int    @id @default(autoincrement())
  store_id  Int
  period    String
  sku       String
  reason_id Int

  quantity_removed Int
  /// What the file literally said on that line. Audit only — explicitly NOT a
  /// quantity anything computes from.
  source_text String?
  ingestion_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  reason RemovalReason @relation(fields: [reason_id], references: [id])

  @@unique([store_id, period, sku, reason_id])
  @@index([store_id, period])
  @@map("removal_record")
}

/// Units moved into or out of a store via an inventory adjustment — never a
/// restock, never a removal.
///
/// The field mixes deliberate transfers between stores, self-checkout
/// mismatches, and data-entry error, indistinguishable from the export alone
/// (align-ingestion-with-real-reports design D4/D6). Stored separately for
/// the same reason removals are stored already split: netting it into
/// restocked value or into loss would make either figure depend on a
/// re-derivation this service never performs.
model AdjustmentRecord {
  id       Int    @id @default(autoincrement())
  store_id Int
  period   String
  sku      String

  /// Signed: positive is inbound, negative is outbound.
  quantity     Int
  ingestion_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([store_id, period, sku])
  @@index([store_id, period])
  @@map("adjustment_record")
}

/// The closing balance the operators themselves recorded for a store, period
/// and SKU — a cross-check for inventory-service's derived figure (design
/// D5), never a second source of truth. Absent for a period ingested before
/// this cross-check existed.
model RecordedClosingBalance {
  id       Int    @id @default(autoincrement())
  store_id Int
  period   String
  sku      String

  quantity     Int
  ingestion_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([store_id, period, sku])
  @@index([store_id, period])
  @@map("recorded_closing_balance")
}

/// Marks that a store's period was ingested, so "never ingested" stays
/// distinguishable from "ingested with no restocks or removals".
model IngestedPeriod {
  id       Int    @id @default(autoincrement())
  store_id Int
  period   String

  ingestion_id String
  restock_count Int
  removal_count Int
  ingested_at  DateTime @default(now())

  @@unique([store_id, period])
  @@map("ingested_period")
}

/// One supply operation (a "visit") of a store, as the restocking report stated it.
///
/// Additive to the monthly records above and never a source for them: they are
/// summed per SKU and lose the visit boundary, this keeps it, so a consumer can
/// follow a SKU's balance from one visit to the next without re-parsing a
/// report (add-stock-quality-phase0). A visit belongs to the period it was
/// ingested under, like its monthly quantities, and is replaced wholesale with
/// them.
model SupplyVisit {
  id       Int    @id @default(autoincrement())
  store_id Int
  period   String

  /// 'restocking' | 'inventory' | 'combined'
  kind String

  started_at       DateTime?
  ended_at         DateTime
  /// The report's own "Operação anterior finalizada em", when it stated one — never inferred.
  previous_ended_at DateTime?
  /// The sheet in the source workbook, for tracing a figure back to the file.
  source_reference String
  ingestion_id     String

  created_at DateTime @default(now())

  lines SupplyVisitLine[]

  @@index([store_id, ended_at])
  @@index([store_id, period])
  @@map("supply_visit")
}

/// One SKU's reading within one visit.
///
/// `confirmed_count` is the count made BEFORE restocking, and is NULL when the
/// report cell was empty — which is not a count of zero (only ~27% of lines are
/// counted). `quantity_to_restock` is NULL for the same reason.
model SupplyVisitLine {
  id       Int    @id @default(autoincrement())
  visit_id Int
  sku      String

  balance_before      Int
  confirmed_count     Int?
  quantity_to_restock Int?
  restocked           Int
  /// Signed, zero or negative — the report's `Remoções` number.
  removed_total       Int
  /// Signed `Diferença`.
  adjustment          Int
  balance_after       Int

  visit SupplyVisit @relation(fields: [visit_id], references: [id], onDelete: Cascade)

  @@index([visit_id, sku])
  @@map("supply_visit_line")
}
