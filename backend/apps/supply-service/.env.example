# supply-service — copy to .env for local runs outside Docker.
#
# No WITH_KAFKA_BROKERS: this service registers no queues, so it never imports
# HoldItModule. Any service that DOES must set it to false — see the root
# .env.example.

DATABASE_URL=postgresql://agiliz:agiliz-dev-secret@127.0.0.1:5437/supply

PORT=3000

SUPPLY_POSTGRES_USER=agiliz
SUPPLY_POSTGRES_PASSWORD=agiliz-dev-secret
SUPPLY_POSTGRES_DB=supply
SUPPLY_POSTGRES_HOST_PORT=5437

# This service consumes a BullMQ queue, so it needs the shared Redis from the
# `infra` project — and therefore the Kafka guard.
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6379
# Leaving this unset defaults it to TRUE inside @app/hold-it, which pulls in a
# Kafka broker needing an ElasticsearchService nothing provides — NestJS then
# fails at startup. Config validation makes it required so that is loud.
WITH_KAFKA_BROKERS=false
