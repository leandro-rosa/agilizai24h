{
  "name": "@agiliz/gateway-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register --project tsconfig.app.json src/main.ts",
    "start": "node -r ../../../register-paths.js dist/apps/gateway-service/src/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.app.json --composite false --noEmit",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.js --runInBand --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/supertest": "^6.0.3",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
