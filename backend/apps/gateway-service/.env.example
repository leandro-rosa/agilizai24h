# gateway-service — copy to .env for local runs outside Docker.
#
# No DATABASE_URL: this is the one service without a database (design D2).
# No WITH_KAFKA_BROKERS: it registers no queues yet. add-ingestion-flow adds
# them, and must set it to false when it does.

# Reached by container name inside agiliz_network.
IAM_SERVICE_URL=http://agiliz-iam-prod:3000
STORES_SERVICE_URL=http://agiliz-stores-prod:3000
PRODUCTS_SERVICE_URL=http://agiliz-products-prod:3000
FINANCE_SERVICE_URL=http://agiliz-finance-prod:3000
SALES_SERVICE_URL=http://agiliz-sales-prod:3000
SUPPLY_SERVICE_URL=http://agiliz-supply-prod:3000
INVENTORY_SERVICE_URL=http://agiliz-inventory-prod:3000
INGESTION_SERVICE_URL=http://agiliz-ingestion-prod:3000
SUPPLIERS_SERVICE_URL=http://agiliz-suppliers-prod:3000
TREASURY_SERVICE_URL=http://agiliz-treasury-prod:3000
ACCOUNTING_SERVICE_URL=http://agiliz-accounting-prod:3000
BILLING_SERVICE_URL=http://agiliz-billing-prod:3000
CAPEX_SERVICE_URL=http://agiliz-capex-prod:3000

PORT=3000

# Per-call timeout, and the overall deadline that bounds @app/http-client's
# internal 12-attempt retry loop — without it a timed-out upstream keeps a
# request alive for ~40s instead of failing fast with 502.
UPSTREAM_TIMEOUT_MS=3000
UPSTREAM_DEADLINE_MS=5000

# Host port. The gateway is the only backend service that publishes one.
GATEWAY_HOST_PORT=3080
