# treasury-service — copy to .env for local runs outside Docker.

# This service's own database. Database-per-service: no other service reads
# these tables.
DATABASE_URL=postgresql://agiliz:agiliz-dev-secret@127.0.0.1:5442/treasury

PORT=3000

# @app/hold-it — this service's first queue consumer (add-treasury-statement-
# ingestion's TREASURY_QUEUES.RAW_ROWS). Shared Redis from docker/composes/
# docker-compose.infra.yaml, same as every other queue-registering service.
# WITH_KAFKA_BROKERS must be false: unset, @app/hold-it defaults it to true,
# which pulls in a Kafka broker requiring a service nothing here provides.
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6379
WITH_KAFKA_BROKERS=false

# Postgres container settings consumed by docker-compose.yml. Host ports
# 5433-5440 are taken by the services that came before this one.
TREASURY_POSTGRES_USER=agiliz
TREASURY_POSTGRES_PASSWORD=agiliz-dev-secret
TREASURY_POSTGRES_DB=treasury
TREASURY_POSTGRES_HOST_PORT=5442
