generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A SKU in the canonical catalogue.
model Product {
  id       Int    @id @default(autoincrement())
  sku      String @unique
  name     String
  /// 'meal' | 'snack' | 'beverage' | 'essential' — see PRODUCT_CATEGORY_VALUES.
  category String

  /// The name folded for matching (case, accents, whitespace). Stored rather
  /// than computed per read, because ingestion resolves thousands of names per
  /// uploaded file. Not unique: two catalogue products may normalise to the
  /// same string, and that ambiguity must be reported, not silently resolved.
  normalized_name String

  /// Campos das abas `produtos`, `lista de produtos mercado`,
  /// `lista congelados` e `produtos agiliz.ai` da planilha de relatórios.
  /// Todos opcionais: os 232 produtos existentes não têm nenhum deles, e um
  /// NOT NULL faria a migration falhar em base com dado real.
  ///
  /// "Marmitas", "Crepes", "Vinhos" — o segundo nível de `category`.
  subcategory     String?
  /// Código de barras. Unique porque dois produtos com o mesmo EAN é erro de
  /// cadastro, e o PDV resolve venda por ele.
  ean             String? @unique
  /// suppliers-service. Int cru — database-per-service.
  supplier_id     Int?
  /// "400g", "280g" — texto, é como vem da planilha e do rótulo.
  net_weight      String?
  ncm             String?
  cest            String?
  /// Coluna "Validade (dias)".
  shelf_life_days Int?
  /// active | discontinued
  status          String  @default("active")

  /// Unidades por embalagem de compra (ex.: caixa de 24). Distinto do
  /// "múltiplo operacional da loja" (não modelado ainda) — uma loja pode
  /// receber em fração dessa embalagem mesmo quando fractionable é true.
  units_per_package Int?
  /// "caixa" | "fardo" | "pacote" | outro texto livre — sem vocabulário
  /// fechado ainda.
  package_type      String?
  /// Se a embalagem de compra pode ser fracionada no abastecimento.
  fractionable      Boolean?

  /// Unidade em que o produto é vendido ("un", "kg", "porção"). O código interno do produto é o próprio SKU.
  sale_unit String @default("un")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cost_versions  CostVersion[]
  price_versions PriceVersion[]
  name_overrides ProductNameOverride[]

  @@index([normalized_name])
  @@map("product")
}

/// A cost effective from a date, never overwritten.
///
/// There is deliberately NO `current_cost` column on Product. A mutable
/// "current cost" is the easy thing to read by accident, and reading it for a
/// historical month silently reprices that month — the figures just change,
/// with nothing to indicate it. Modelling cost only as a dated series means
/// there is no such field to read.
model CostVersion {
  id         Int      @id @default(autoincrement())
  product_id Int
  /// The date this cost takes effect. A lookup picks the latest version whose
  /// effective_from is on or before the requested date.
  effective_from DateTime @db.Date
  /// Integer minor units (centavos). Never a float: these values are summed
  /// across thousands of rows and multiplied by quantities, which is exactly
  /// the pattern that accumulates binary floating-point error — and the
  /// resulting mismatch against the operator's spreadsheet would be small,
  /// real, and very expensive to diagnose.
  cost_cents Int

  /// manual | invoice | pricing_intelligence | catalogue_sync | legacy_import | other.
  /// `legacy_import` is only written by the migration: the origin of those rows was never recorded.
  source String
  /// Who entered it, when a person did (the session user, never what the client sent).
  actor  String?
  reason String?
  /// Idempotency key of the origin (e.g. the purchase item id): (source, source_ref) is unique when set.
  source_ref String?
  /// Set when the version comes from a purchase: no other service's table is referenced, only its ids.
  supplier_id      Int?
  purchase_id      Int?
  purchase_item_id Int?
  invoice_number   String?
  /// What was bought as it came on the invoice, so the unit cost can be audited.
  purchase_quantity    Int?
  purchase_total_cents Int?
  pack_quantity        Int?
  units_per_pack       Int?

  /// Recording time. The version is never updated afterwards: a correction is a NEW version.
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  /// NOT unique: recording the same effective date again adds a corrective version and keeps the earlier one.
  /// Which one is in force is decided at read time (see `utils/resolve-version.ts`). The only uniqueness is the
  /// partial index on (source, source_ref), created in the migration because Prisma cannot express it.
  @@index([product_id, effective_from])
  @@map("cost_version")
}

/// A manually curated mapping from a name seen in a POS export to a catalogue
/// product, for names normalisation alone cannot resolve.
///
/// Operational data that grows as real mismatches appear, so it is a table
/// rather than a constant in code — a mismatch must be fixable without a
/// deploy. An override always beats a normalised match: it exists because a
/// human looked at a real mismatch and decided the answer.
/// Preço de venda datado, espelhando CostVersion.
///
/// Markup e margem NÃO são colunas: são derivadas de custo × preço na data, e
/// persistir os três garante que um dia discordem entre si. A planilha tem
/// exatamente esse problema — "Markup", "Valor venda s/ tx" e "Venda venda"
/// convivem e nem sempre fecham.
model PriceVersion {
  id             Int      @id @default(autoincrement())
  product_id     Int
  effective_from DateTime @db.Date
  price_cents    Int

  /// Same provenance as CostVersion. For `pricing_intelligence`, `source_ref` is the pricing decision id.
  source     String
  actor      String?
  reason     String?
  source_ref String?

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  /// NOT unique, same as CostVersion: a same-date correction is a new version. Partial unique on (source, source_ref) in the migration.
  @@index([product_id, effective_from])
  @@map("price_version")
}

model ProductNameOverride {
  id         Int    @id @default(autoincrement())
  /// The normalised form of the external name this override matches.
  source_normalized_name String @unique
  /// Kept for operators to see what was actually written in the file.
  source_name String
  product_id  Int

  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_name_override")
}

/// Decisão de um operador sobre um par de SKUs: o `new_sku` é o MESMO produto
/// que o `old_sku` com outro código de barras ("same"), ou NÃO é ("different",
/// para a tela não perguntar de novo). O sistema só SUGERE pares por nome;
/// nenhuma vinculação é feita sem esta confirmação humana.
model SkuLink {
  id         Int      @id @default(autoincrement())
  old_sku    String
  new_sku    String
  /// same | different
  decision   String
  decided_at DateTime @default(now())

  @@unique([old_sku, new_sku])
  @@index([new_sku])
  @@map("sku_link")
}
