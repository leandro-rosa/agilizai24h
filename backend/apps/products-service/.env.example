# products-service — copy to .env for local runs outside Docker.
#
# No WITH_KAFKA_BROKERS: this service registers no queues, so it never imports
# HoldItModule. Any service that DOES must set it to false — see the root
# .env.example.

DATABASE_URL=postgresql://agiliz:agiliz-dev-secret@127.0.0.1:5435/products

PORT=3000

PRODUCTS_POSTGRES_USER=agiliz
PRODUCTS_POSTGRES_PASSWORD=agiliz-dev-secret
PRODUCTS_POSTGRES_DB=products
PRODUCTS_POSTGRES_HOST_PORT=5435
