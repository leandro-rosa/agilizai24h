generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A physical Agiliz.AI location.
///
/// `status` and `type` are plain strings validated at the DTO layer rather than
/// Prisma enums: both vocabularies are expected to grow, and an enum would need
/// a migration every time one does.
model Store {
  id   Int    @id @default(autoincrement())
  name String
  address String
  city    String
  /// 'company' | 'condo' — see STORE_TYPE_VALUES.
  type    String
  /// 'active' | 'maintenance' | 'inactive' — see STORE_STATUS_VALUES. There is
  /// no deletion: historical sales and reconciliations must keep resolving
  /// their store even after it closes.
  status  String @default("active")

  /// The code the POS platform uses for this store in its exported reports.
  /// Nullable because a store may be registered before its code is known, and
  /// unique so an uploaded file resolves to exactly one store. Indexed: it is
  /// looked up once per ingested file.
  external_code String? @unique

  /// Atributos vindos das abas `Clientes` e `INVESTIMENTO` da planilha de
  /// relatórios. Todos opcionais: nenhuma das 24 lojas existentes tem esses
  /// dados hoje, e uma migration com NOT NULL falharia em base com dado real.
  ///
  /// CNPJ da unidade que hospeda a loja.
  tax_id      String?
  /// "HTL05", "SPO01" — o código do site do cliente. Casa com
  /// `ClientSite.code` no billing-service. Diferente de `external_code`, que
  /// é o código do PDV (touchpay).
  client_code String?
  opened_on   DateTime? @db.Date
  /// "quantidade de pessoas" — o denominador do ticket médio por loja.
  headcount   Int?
  /// "110v", "220v", "1-110v 1-220v" — a instalação elétrica disponível.
  /// Texto livre porque a planilha registra combinação, não um valor único.
  voltage     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@map("store")
}
