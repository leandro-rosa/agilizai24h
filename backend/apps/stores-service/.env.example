# stores-service — copy to .env for local runs outside Docker.
#
# NOTE: no WITH_KAFKA_BROKERS here. That variable works around a DI hazard in
# @app/hold-it, and this service registers no queues, so it never imports
# HoldItModule. Any service that DOES register it must set it to false or
# NestJS fails at startup — see the root .env.example.

# This service's own database. Database-per-service: no other service reads
# these tables.
DATABASE_URL=postgresql://agiliz:agiliz-dev-secret@127.0.0.1:5434/stores

PORT=3000

# Postgres container settings consumed by docker-compose.yml. The host port
# differs from iam-service's so both can run side by side.
STORES_POSTGRES_USER=agiliz
STORES_POSTGRES_PASSWORD=agiliz-dev-secret
STORES_POSTGRES_DB=stores
STORES_POSTGRES_HOST_PORT=5434
