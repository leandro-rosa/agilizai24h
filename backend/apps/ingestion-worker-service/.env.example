# ingestion-worker-service — copy to .env for local runs outside Docker.

DATABASE_URL=postgresql://agiliz:agiliz-dev-secret@127.0.0.1:5438/ingestion
PORT=3000

# Consumes and publishes queues, so it needs the shared Redis from `infra`.
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6379
# Unset defaults to TRUE in @app/hold-it and crashes NestJS at startup.
WITH_KAFKA_BROKERS=false

# Resolves store codes and product names while parsing.
STORES_SERVICE_URL=http://agiliz-stores-prod:3000
PRODUCTS_SERVICE_URL=http://agiliz-products-prod:3000

# Object storage holds the raw uploads; Postgres holds only parsed data.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=agiliz
AWS_SECRET_ACCESS_KEY=agiliz-dev-secret
AWS_S3_BUCKET=agiliz-uploads
AWS_S3_ENDPOINT=http://127.0.0.1:9010
AWS_S3_FORCE_PATH_STYLE=true

INGESTION_POSTGRES_USER=agiliz
INGESTION_POSTGRES_PASSWORD=agiliz-dev-secret
INGESTION_POSTGRES_DB=ingestion
INGESTION_POSTGRES_HOST_PORT=5438

# Google Drive source (add-drive-ingestion-source) — every variable is optional.
# Leave GOOGLE_DRIVE_ROOT_FOLDER_ID and the credential unset to keep the feature off; setting
# only one of them makes the service refuse to start. The credential is a secret: it goes only
# in your local .env, never in the repo.
# GOOGLE_DRIVE_ROOT_FOLDER_ID=            # id of the "Vendas x abastecimento" folder (last part of its URL)
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=     # `base64 -w0 key.json` of the service account key
# GOOGLE_SERVICE_ACCOUNT_FILE=            # alternative to the line above: a path to the key file
# DRIVE_SCAN_CRON=0 6 * * *               # daily scan, evaluated in America/Sao_Paulo
# DRIVE_AUTO_VALIDATE=true                # validate new/changed files after each scan (never imports)
# DRIVE_MAX_FILE_BYTES=26214400           # 25 MiB, the same as the gateway's manual upload
# DRIVE_INCLUDE_PATTERNS=relat[oó]rio,abasteciment   # which file/folder names are tracked
# DRIVE_SYNTHETIC_PATTERN=sint[eé]tic|synthetic|\[teste\]   # names refused as synthetic
# DRIVE_PERIOD_MATCH_MIN_SHARE=0.90       # share of dated rows that must fall in the selected month
# DRIVE_WEEKDAY_OPEN_MIN_SHARE=0.50       # a weekday is "normal" for a store above this share of occurrences
# DRIVE_COVERAGE_MIN_POOLED=0.90          # file coverage on expected operating days
# DRIVE_COVERAGE_MIN_STORE=0.70           # per-store coverage on expected operating days
# DRIVE_EDGE_TOLERANCE_DAYS=3             # days the first/last row may sit inside the month boundaries
