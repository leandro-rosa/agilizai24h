generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One uploaded file and what became of it.
model Ingestion {
  id        String @id
  /// 'sales' | 'supply' | 'cost' — see INGESTION_FILE_TYPES.
  file_type String
  /// Where the raw file lives. Object storage holds the file; this database
  /// holds only structured data about it.
  object_key    String
  original_name String

  /// Stated by the uploader for sales and cost, which carry no store identity
  /// of their own. Null for supply (restocking): that workbook covers every
  /// store in the month, one operation per sheet, each naming its OWN store
  /// via `Cliente` — see IngestionOperation and design D2 of
  /// align-ingestion-with-real-reports. Never inferred for sales/cost: that
  /// workbook has no reliable machine-readable period either, and guessing
  /// silently attributes March's data to April.
  store_id Int?
  period   String

  /// 'accepted' | 'processing' | 'completed' | 'partially_completed' | 'failed'
  status String @default("accepted")
  error  String?

  /// Chunk accounting. smartChunk splits a file into N queue jobs; the sinks
  /// replace a period wholesale, so rows are staged until every chunk has
  /// landed and then handed over as ONE batch. Without this the last chunk
  /// would wipe what the earlier ones wrote.
  expected_chunks  Int @default(0)
  processed_chunks Int @default(0)

  accepted_rows Int @default(0)
  rejected_rows Int @default(0)

  correlation_id String?
  uploaded_at    DateTime @default(now())
  updated_at     DateTime @updatedAt

  staged               StagedRow[]
  staged_transactions  StagedSalesTransaction[]
  rejections           IngestionRejection[]
  operations           IngestionOperation[]

  @@index([store_id, period])
  @@index([status])
  @@map("ingestion")
}

/// One operation — one sheet — within a restocking workbook.
///
/// Read once, up front, before any product row is touched (the pre-scan in
/// `locate-restocking-operations.ts`). Every later row-processing job looks
/// itself up here by sheet name instead of re-reading the workbook, and this
/// is what lets one file resolve to many different stores (design D2).
model IngestionOperation {
  id           Int    @id @default(autoincrement())
  ingestion_id String

  sheet_name String
  /// The raw "Cliente" text, kept even when resolution failed — the rejection
  /// needs it to name what was tried.
  client_raw String
  /// Null until resolved; stays null when no registered store matches.
  store_id Int?

  /// 'restocking' | 'inventory' | 'combined' — see operation-kinds.ts.
  operation_kind String

  /// The export's own "Finalizado em" for this operation. The same store and
  /// SKU can appear in several operations within one month — this is what
  /// lets `finalize()` pick the LATEST reported closing balance as the
  /// month's recorded figure rather than an arbitrary earlier one.
  finished_at DateTime?

  created_at DateTime @default(now())

  ingestion Ingestion @relation(fields: [ingestion_id], references: [id], onDelete: Cascade)

  @@unique([ingestion_id, sheet_name])
  @@map("ingestion_operation")
}

/// A parsed, resolved row waiting for every chunk of its file to arrive.
///
/// Staging exists solely so the sinks receive one replacement batch per period
/// instead of one per chunk. It is deleted once the batch is handed over.
model StagedRow {
  id           Int    @id @default(autoincrement())
  ingestion_id String

  /// Resolved store for THIS row. For sales/cost, copied from the ingestion's
  /// own store_id at staging time. For supply, resolved per-operation — one
  /// restocking file spans many stores, so this can differ row to row within
  /// the same ingestion.
  store_id Int
  /// Which operation (sheet) this row came from — supply rows only. Lets
  /// `finalize()` join back to IngestionOperation to pick the recorded
  /// closing balance from whichever operation finished last.
  sheet_name String?

  sku String
  /// 'restock' | 'removal' | 'adjustment' for supply rows; null for sales and
  /// cost rows, which have no movement kind to distinguish.
  movement_kind String?
  /// Set only for removal rows.
  reason_key String?

  quantity   Int?
  /// Integer minor units. Revenue for sales rows, cost for cost rows.
  amount_cents Int?
  /// What the file said on the removal line — audit only.
  source_text String?
  /// The operators' own "Qtd. final" for this row — a cross-check on derived
  /// stock (design D5), carried through rather than resolved here, since only
  /// `finalize()` sees every operation and can pick the latest one.
  recorded_closing_balance Int?

  ingestion Ingestion @relation(fields: [ingestion_id], references: [id], onDelete: Cascade)

  @@index([ingestion_id])
  @@index([ingestion_id, store_id])
  @@map("staged_row")
}

/// A parsed, per-transaction sales detail row waiting for every chunk of its
/// file to arrive — same reason `StagedRow` exists, a separate table rather
/// than more nullable columns on it (see add-sales-transaction-detail design
/// D1): none of these ~14 fields mean anything for a supply or cost row.
/// Only staged for the network-wide, per-transaction sales format; an
/// old-format sales upload never produces any of these.
model StagedSalesTransaction {
  id           Int    @id @default(autoincrement())
  ingestion_id String

  store_id    Int
  occurred_at DateTime?
  sku         String
  quantity    Int

  /// Integer minor units. Never a float.
  amount_paid_cents     Int
  original_amount_cents Int?
  discount_cents        Int?
  /// Amount settled after acquirer/payment fees — a treasury concept, never CMV/margin.
  net_amount_cents      Int?
  /// The receipt/basket identifier — groups several rows into one purchase.
  coupon                String?

  /// Verbatim from the report's Resultado column — every attempted
  /// transaction is staged here, not only completed sales (see
  /// add-sales-transaction-detail design D4).
  result String

  method           String?
  acquirer         String?
  card_brand       String?
  card_last_digits String?
  internal_code    String?
  acquirer_code    String?
  pos_id           String?
  machine_model    String?
  buyer_number     String?

  ingestion Ingestion @relation(fields: [ingestion_id], references: [id], onDelete: Cascade)

  @@index([ingestion_id])
  @@map("staged_sales_transaction")
}

/// A row that could not be processed, kept so the operator can fix the file.
///
/// Rejections are recorded rather than skipped: a skipped row produces a total
/// that is quietly too low, with nothing to indicate it.
model IngestionRejection {
  id           Int    @id @default(autoincrement())
  ingestion_id String

  /// Which row of which sheet, so it can be found in the file.
  row_reference String
  reason        String
  detail        String

  created_at DateTime @default(now())

  ingestion Ingestion @relation(fields: [ingestion_id], references: [id], onDelete: Cascade)

  @@index([ingestion_id])
  @@map("ingestion_rejection")
}

/// One file found in the Google Drive folder (add-drive-ingestion-source): its metadata, what
/// validating it found, and what became of it. A scan writes only metadata; nothing here ever
/// holds a row of the file — `validation_report` is aggregates and findings.
///
/// `imported_ingestion_id` and `duplicate_of_id` are plain columns, not foreign keys: the
/// `Ingestion` model stays untouched, and the "derived status" of an imported file whose
/// ingestion later failed is a second query rather than a join.
model DriveFile {
  id            String @id @default(uuid())
  /// The Drive's own id — the identity of the file across renames and moves.
  drive_file_id String @unique
  name          String
  /// Folder path from the configured root, e.g. `agosto-26/Relatório_2026`.
  path          String
  mime_type     String
  /// Null for native Google Sheets, which report no size.
  size_bytes    Int?
  /// md5Checksum when the Drive provides one, else "{modifiedTime}#{version}".
  fingerprint   String
  /// The name or path matched the synthetic marker: never importable.
  is_synthetic  Boolean @default(false)

  suggested_file_type String?
  suggested_period    String?
  suggestion_note     String?

  /// 'new' | 'changed' | 'importing' | 'imported' | 'ignored' | 'missing' | 'error'
  status String @default("new")
  error  String?

  /// 'none' | 'validating' | 'passed' | 'needs_validation' | 'blocked' | 'failed'
  validation_status     String    @default("none")
  /// Aggregated result of validating the file — see ValidationReport. No row-level content.
  validation_report     Json?
  /// The fingerprint the report was computed on; a different one means the file changed.
  validated_fingerprint String?
  validated_at          DateTime?
  content_sha256        String?

  /// Set when the content equals a file already imported for the same type and period.
  duplicate_of_id String?

  /// The person's review of the inconsistencies, bound to the hash they reviewed.
  validation_confirmed_by     String?
  validation_confirmed_at     DateTime?
  validation_confirmed_sha256 String?

  /// The type and period the person confirmed for the import IN FLIGHT. They become
  /// `imported_*` only when the import succeeds, so a re-import that fails never
  /// overwrites what the earlier, successful one recorded.
  import_file_type String?
  import_period    String?

  imported_ingestion_id String?
  imported_fingerprint  String?
  imported_sha256       String?
  imported_file_type    String?
  imported_period       String?
  confirmed_by          String?
  confirmed_at          DateTime?

  first_seen_at DateTime @default(now())
  last_seen_at  DateTime @default(now())
  updated_at    DateTime @updatedAt

  /// Layer 4 of the duplicate-import guard: the same content cannot be imported twice for the
  /// same type and period, even if two imports race. Postgres treats NULLs as distinct, so a
  /// file that was never imported (all three NULL) never collides.
  @@unique([imported_sha256, imported_file_type, imported_period])
  @@index([status])
  @@index([content_sha256])
  @@index([imported_ingestion_id])
  @@map("drive_file")
}

/// One run of the Drive scan, kept for the status view. Only the latest few are retained.
model DriveScanRun {
  id                 Int       @id @default(autoincrement())
  started_at         DateTime  @default(now())
  finished_at        DateTime?
  /// 'schedule' | 'manual'
  trigger            String
  /// 'running' | 'ok' | 'failed'
  outcome            String    @default("running")
  files_seen         Int       @default(0)
  /// Files skipped because their name matched none of the configured patterns.
  skipped_by_pattern Int       @default(0)
  new_count          Int       @default(0)
  changed_count      Int       @default(0)
  error              String?

  @@index([started_at])
  @@map("drive_scan_run")
}
