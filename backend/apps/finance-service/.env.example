# finance-service — copy to .env for local runs outside Docker.
#
# No WITH_KAFKA_BROKERS: this service registers no queues, so it never imports
# HoldItModule. Any service that DOES must set it to false — see the root
# .env.example.

DATABASE_URL=postgresql://agiliz:agiliz-dev-secret@127.0.0.1:5440/finance

PORT=3000

FINANCE_POSTGRES_USER=agiliz
FINANCE_POSTGRES_PASSWORD=agiliz-dev-secret
FINANCE_POSTGRES_DB=finance
FINANCE_POSTGRES_HOST_PORT=5440

# This service consumes a BullMQ queue, so it needs the shared Redis from the
# `infra` project — and therefore the Kafka guard.
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6379
# Leaving this unset defaults it to TRUE inside @app/hold-it, which pulls in a
# Kafka broker needing an ElasticsearchService nothing provides — NestJS then
# fails at startup. Config validation makes it required so that is loud.
WITH_KAFKA_BROKERS=false

# Movement sources. A 404 from either is "no data for that period", not a failure.
SALES_SERVICE_URL=http://agiliz-sales-prod:3000
SUPPLY_SERVICE_URL=http://agiliz-supply-prod:3000
INVENTORY_SERVICE_URL=http://agiliz-inventory-prod:3000
PRODUCTS_SERVICE_URL=http://agiliz-products-prod:3000
