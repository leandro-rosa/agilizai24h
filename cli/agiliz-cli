#!/usr/bin/env bash
# Gerencia os projetos Docker Compose da devbox Agiliz.AI.

set -Eeuo pipefail

readonly PROGRAM_NAME='agiliz-cli'
readonly PROGRAM_VERSION='0.1.0'
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
readonly PROJECT_ROOT="${AGILIZ_ROOT:-$(cd -- "${SCRIPT_DIR}/.." && pwd -P)}"
readonly SHARED_NETWORK_NAME='agiliz_network'
# 'infra' (Redis + MinIO) sobe primeiro e desce por ultimo: os servicos de
# backend dependem dele para BullMQ e storage S3.
readonly -a UP_ORDER=(infra iam stores products gateway site admin)
readonly -a DOWN_ORDER=(admin site gateway products stores iam infra)
readonly -a VALID_PROJECTS=(infra iam stores products gateway site admin)
readonly -A PROJECT_DIRECTORIES=(
  [infra]='docker/composes'
  [iam]='backend/apps/iam-service'
  [stores]='backend/apps/stores-service'
  [products]='backend/apps/products-service'
  [gateway]='backend/apps/gateway-service'
  [site]='frontend/apps/site'
  [admin]='frontend/apps/admin'
)
readonly -A PROJECT_FILES=(
  [infra]='docker-compose.infra.yaml'
  [iam]='docker-compose.yml'
  [stores]='docker-compose.yml'
  [products]='docker-compose.yml'
  [gateway]='docker-compose.yml'
  [site]='docker-compose.yml'
  [admin]='docker-compose.yml'
)
# 'infra' nao aparece aqui nem em PROJECT_PROD_SERVICE de proposito: nao tem
# distincao dev/prod, entao resolve para servico vazio e e afetado por inteiro
# nos dois modos.
readonly -A PROJECT_DEV_SERVICE=(
  [iam]='iam-dev'
  [stores]='stores-dev'
  [products]='products-dev'
  [gateway]='gateway-dev'
  [site]='site-dev'
  [admin]='admin-dev'
)
readonly -A PROJECT_PROD_SERVICE=(
  [iam]='iam-prod'
  [stores]='stores-prod'
  [products]='products-prod'
  [gateway]='gateway-prod'
  [site]='site-prod'
  [admin]='admin-prod'
)

ACTION=''
EXEC_PROJECT=''
EXEC_SERVICE=''
PROD_MODE=false
declare -a EXEC_COMMAND=()
declare -a INCLUDE_PROJECTS=()
declare -a EXCLUDE_PROJECTS=()
declare -a SELECTED_PROJECTS=()
declare -a CHILD_PIDS=()

#######################################
