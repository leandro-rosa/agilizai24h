  ${PROGRAM_NAME} up --production
  ${PROGRAM_NAME} up -i site
  ${PROGRAM_NAME} down -e site
  ${PROGRAM_NAME} logs --include site
  ${PROGRAM_NAME} stats -i site
  ${PROGRAM_NAME} exec site site-dev node --version
  ${PROGRAM_NAME} exec site site-prod
  ${PROGRAM_NAME} deploy:pull
  ${PROGRAM_NAME} deploy:pull --production
  source <(${PROGRAM_NAME} completion bash)

