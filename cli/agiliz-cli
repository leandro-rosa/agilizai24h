#######################################
# Direciona a ajuda para o subcomando solicitado.
# Globals:
#   Nenhuma
# Arguments:
#   $1 - Nome do subcomando.
# Outputs:
#   Escreve a ajuda correspondente em stdout ou erro em stderr.
# Returns:
#   0 para subcomando conhecido; encerra com 2 para nome invalido.
# Side effects:
#   Pode encerrar o processo por meio de die.
#######################################
print_command_help() {
  local command_name="$1"

  case "${command_name}" in
    up) print_up_help ;;
    down) print_down_help ;;
    logs) print_logs_help ;;
    stats) print_stats_help ;;
    exec) print_exec_help ;;
    deploy:pull) print_deploy_pull_help ;;
    completion) print_completion_help ;;
    *) die "Command desconhecido para ajuda: ${command_name}. Use --help." 2 ;;
  esac
}

