# Template for local development. Copy to `.env` and fill in real values —
# `.env` is gitignored and must never be committed.
#
# Every variable below is read by one of the vendored libs in
# backend/common/nest-libs/. Each future microservice copies the subset it
# actually uses into its own .env.example rather than inheriting this whole file.

# ---------------------------------------------------------------------------
# CRITICAL — @app/hold-it startup gotcha
# ---------------------------------------------------------------------------
# WITH_KAFKA_BROKERS defaults to TRUE when unset. That pulls HoldItKafkaBroker
# into the DI graph, which requires HoldItElasticsearchService, which nothing
# provides — so NestJS fails at startup before the service ever listens.
# Leave this set to false in every service (env, docker-compose, AND test setup)
# unless a proposal has first fixed the Kafka DI gap.
WITH_KAFKA_BROKERS=false

# ---------------------------------------------------------------------------
# Database (@app/prisma-db-client) — one physical database PER SERVICE
# ---------------------------------------------------------------------------
# Database-per-service is architectural, not a preference: no service reads
# another service's tables. Each service defines its own DATABASE_URL against
# its own Postgres instance/database, e.g.
#   postgresql://agiliz:agiliz@iam-postgres:5432/iam?schema=public
# No Postgres container ships with the shared infra compose for this reason.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis / BullMQ (@app/hold-it) — shared across all services
# ---------------------------------------------------------------------------
# Shared on purpose: cross-service job delivery only works when every producer
# and consumer point at the same Redis. Inside agiliz_network, reach it by
# container name on the standard port.
REDIS_QUEUE_HOST=agiliz-redis
REDIS_QUEUE_PORT=6379
QUEUE_PASSWORD=

# Host-side port publishing for docker/composes/docker-compose.infra.yaml.
# Override only if these ports are already taken on your machine.
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------------------------------------------------------------------------
# Object storage (@app/aws S3Service) — MinIO in dev, S3 in production
# ---------------------------------------------------------------------------
# Holds the raw uploaded spreadsheets. Postgres stores only parsed, structured
# data — never the files themselves.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=agiliz
AWS_SECRET_ACCESS_KEY=agiliz-dev-secret
AWS_S3_BUCKET=agiliz-uploads
# Point at MinIO in dev; leave empty to use real AWS S3.
AWS_S3_ENDPOINT=http://agiliz-minio:9000
# MinIO needs path-style addressing; real S3 does not.
AWS_S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Pagination default (@app/elasticsearch)
# ---------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20

# ---------------------------------------------------------------------------
# Elasticsearch (@app/elasticsearch) — OPTIONAL
# ---------------------------------------------------------------------------
# Only needed by a service that genuinely requires search/analytics beyond what
# Postgres provides. Do not add it speculatively. Note it is also the
# undeclared dependency behind the WITH_KAFKA_BROKERS gotcha above.
# ELASTIC_SEARCH_URI=
# ELASTIC_SEARCH_USER=
# ELASTIC_SEARCH_PASSWORD=
# ELASTIC_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# Kafka (@app/hold-it) — NOT IN USE
# ---------------------------------------------------------------------------
# The Kafka broker path is broken (see WITH_KAFKA_BROKERS above). These are
# documented only so the variable names are not reinvented if it is ever fixed.
# KAFKA_BROKERS=
# KAFKA_GROUP_ID=
# KAFKA_GROUP_ID_SUFIX=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_ENABLED=
# SCHEMA_REGISTRY_HOST=
# MDM_ENVIRONMENT=
