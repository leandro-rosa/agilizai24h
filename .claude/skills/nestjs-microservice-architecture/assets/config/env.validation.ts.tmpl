// nestjs-microservice-architecture skill template.
// Only declare fields for env vars this app actually reads today — extend
// incrementally as more modules are wired in, don't pre-declare unused vars.
import { plainToInstance } from 'class-transformer';
import { IsInt, IsNotEmpty, IsOptional, IsString, Min, validateSync } from 'class-validator';

class EnvironmentVariables {
  @IsOptional()
  @IsInt()
  @Min(1)
  PORT?: number;

  // Uncomment if this app uses Postgres via modules/db-client:
  // @IsString()
  // @IsNotEmpty()
  // DATABASE_URL: string;

  // Uncomment if this app uses @app/hold-it for queues/workers:
  // @IsString()
  // @IsNotEmpty()
  // REDIS_QUEUE_HOST: string;
  //
  // @IsInt()
  // @Min(1)
  // REDIS_QUEUE_PORT: number;
}

export function validateEnv(config: Record<string, unknown>): EnvironmentVariables {
  const validated = plainToInstance(EnvironmentVariables, config, { enableImplicitConversion: true });
  const errors = validateSync(validated, { skipMissingProperties: false });
  if (errors.length > 0) {
    throw new Error(`Invalid environment configuration:\n${errors.toString()}`);
  }
  return validated;
}
